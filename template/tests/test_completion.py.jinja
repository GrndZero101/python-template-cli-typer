"""Shell completion is emitted on request, by `{{ completion_env_var }}=source_<shell>`.

typer's completion handler ends the process itself with `sys.exit`, so these expect `SystemExit`
rather than a returned code. bash is left out: generating its script runs `bash --version`, which
on Windows starts WSL, and that is neither fast nor deterministic.
"""

import pytest
import typer

from {{ package_name }}.cli import app, main
from {{ package_name }}.config import PROG_NAME

COMPLETE_VAR = "{{ completion_env_var }}"


@pytest.mark.parametrize("shell", ["zsh", "fish", "powershell", "pwsh"])
def test_each_shell_gets_a_script_naming_the_program(
    shell: str, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    monkeypatch.setenv(COMPLETE_VAR, f"source_{shell}")
    with pytest.raises(SystemExit) as exited:
        main([])
    captured = capsys.readouterr()
    assert exited.value.code == 0
    assert "not supported" not in captured.out + captured.err
    assert PROG_NAME in captured.out


def test_a_command_name_completes(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    """The app's first command completes from its first two letters, whatever the project named it.

    PowerShell's completions arrive one per line, as `name:::help`.
    """
    command = typer.main.get_command(app)
    assert isinstance(command, typer.main.TyperGroup)
    name = next(iter(command.commands))
    monkeypatch.setenv(COMPLETE_VAR, "complete_powershell")
    monkeypatch.setenv("_TYPER_COMPLETE_ARGS", f"{PROG_NAME} {name[:2]}")
    monkeypatch.setenv("_TYPER_COMPLETE_WORD_TO_COMPLETE", name[:2])
    with pytest.raises(SystemExit):
        main([])
    completed = [line.split(":::")[0] for line in capsys.readouterr().out.splitlines()]
    assert name in completed
